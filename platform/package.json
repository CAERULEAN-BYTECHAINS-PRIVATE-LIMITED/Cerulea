{
  "name": "cerulea-studio",
  "private": true,
  "scripts": {
  "build": "turbo build --filter=frontend",
  "dev": "turbo dev",
  "lint": "turbo lint",
  "format": "prettier --write \"**/*.{ts,tsx,md}\""
},
  "workspaces": [
    "apps/*"
  ],
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "latest"
  },
  "packageManager": "pnpm@8.0.0",
  "engines": {
    "node": ">=18"
  }
}